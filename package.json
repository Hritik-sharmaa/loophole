{
  "name": "loophole",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @loophole/web --filter @loophole/api run dev",
    "dev:web": "pnpm --filter @loophole/web run dev",
    "dev:api": "pnpm --filter @loophole/api run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "piston:up": "docker compose -f infra/docker-compose.yml up -d",
    "piston:down": "docker compose -f infra/docker-compose.yml down"
  }
}
